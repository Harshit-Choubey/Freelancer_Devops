# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas (Cloud - Production)
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/gigmatrix?retryWrites=true&w=majority"

# Local MongoDB (Development)
DATABASE_URL="mongodb://127.0.0.1:27017/gigmatrix"

# ─── JWT Configuration ────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_EXPIRES_IN=7d

# ─── Email Configuration ──────────────────────────────────────────────────────
# For real email sending (Gmail App Password required)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Leave blank for development (OTP logged to console)
# EMAIL_USER=
# EMAIL_PASS=

# ─── File Upload Configuration ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# ─── Redis Configuration (Optional - for Socket.IO scaling) ──────────────────
# Set REDIS_ENABLED=true when running with Redis container
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# ─── Docker / Production Overrides ───────────────────────────────────────────
# When running in Docker Compose, set:
# DATABASE_URL=mongodb://mongo:27017/gigmatrix
# REDIS_URL=redis://redis:6379
# FRONTEND_URL=http://nginx:80
# NODE_ENV=production
