{
  "title": "Docker Container Monitoring",
  "uid": "containers-01",
  "panels": [
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "targets": [{"expr": "container_memory_usage_bytes{id=~'/docker/.*'}", "legendFormat": "{{name}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [{"expr": "rate(container_cpu_usage_seconds_total{id=~'/docker/.*'}[1m])", "legendFormat": "{{name}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    }
  ]
}
